<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: -fx-primary-bg;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="arkheim.client.presentation.controllers.LoginController">
    <!-- Left panel: Giant monochrome X logo -->
    <StackPane minWidth="400.0" styleClass="landing-left-panel" HBox.hgrow="ALWAYS">
        <Region styleClass="x-logo-giant" StackPane.alignment="CENTER" />
    </StackPane>

    <!-- Right panel: Sign in flows -->
    <StackPane minWidth="450.0" styleClass="landing-right-panel" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER_LEFT" maxHeight="500.0" spacing="20.0" styleClass="landing-form-container">
            
            <VBox spacing="12.0" style="-fx-padding: 30px 0px 0px 0px;">
                <Label styleClass="form-title" text="Sign in to X" />
                
                <TextField fx:id="emailField" prefHeight="45.0" promptText="Email" />
                <PasswordField fx:id="passwordField" prefHeight="45.0" promptText="Password" />
                
                <Label fx:id="errorLabel" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                
                <Button fx:id="loginButton" maxWidth="Infinity" onAction="#onLoginClicked" prefHeight="45.0" styleClass="button-primary" text="Sign In" />
                
                <VBox spacing="8.0" style="-fx-padding: 20px 0px 0px 0px;">
                    <Label style="-fx-text-fill: -fx-text-secondary; -fx-font-size: 14px;" text="Don't have an account?" />
                    <Button maxWidth="Infinity" onAction="#onGoToRegisterClicked" prefHeight="45.0" styleClass="button-secondary" text="Create account" />
                </VBox>
            </VBox>
        </VBox>
    </StackPane>
</HBox>
